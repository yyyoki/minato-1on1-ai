{
  "name": "ミナト（1on1見守りAI）",
  "image": "mcr.microsoft.com/devcontainers/python:3.12",
  "containerEnv": {
    "ALLOWED_HOST_SUFFIXES": ".app.github.dev"
  },
  "postCreateCommand": "pip install -r requirements.txt && cp -n config.example.json config.json",
  "postStartCommand": "bash .devcontainer/start.sh",
  "forwardPorts": [
    8001
  ],
  "portsAttributes": {
    "8001": {
      "label": "ミナト（Chromeで開く）",
      "onAutoForward": "openBrowser"
    }
  },
  "postAttachCommand": "bash .devcontainer/start.sh"
}
